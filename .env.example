APP_NAME=DeckTrove
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=decktrove
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local

# Where avatars and re-hosted card images are stored. "public" locally (needs `php artisan storage:link`).
# On Laravel Cloud: the disk name of an attached public bucket, plus AWS_URL set to the bucket's public URL.
MEDIA_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Scryfall asks API clients to identify themselves with a descriptive User-Agent.
SCRYFALL_USER_AGENT="DeckTrove/1.0"

VITE_APP_NAME="${APP_NAME}"
